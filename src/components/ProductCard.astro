---
import CandleVisual from './CandleVisual.astro';
import type { Collection } from '../data/collections';
import { formatCOP, fromPrice } from '../data/pricing';

interface Props {
  collection: Collection;
}

const { collection } = Astro.props;
const price = fromPrice(collection);
---

<article class="group" data-collection={collection.slug}>
  <a href={`/producto/${collection.slug}`} class="block">
    <div class="overflow-hidden rounded-xs border border-cream-300 bg-cream-100">
      <CandleVisual
        class="aspect-[4/5] transition-transform duration-700 ease-soft group-hover:scale-[1.02]"
        accent={collection.theme.accent}
        soft={collection.theme.soft}
        label={collection.name}
        sublabel={collection.aroma}
      />
    </div>

    <div class="mt-4 flex items-start justify-between gap-4">
      <div>
        <p class="eyebrow text-terracotta-700">Colección {collection.number}</p>
        <h3 class="mt-1 font-display text-xl leading-tight text-jade-900">
          {collection.name}
        </h3>
        <p class="mt-1 text-sm text-ink/65">{collection.aroma}</p>
        {price !== null && (
          <p class="mt-2 text-[0.72rem] text-jade-900/60">
            Desde <span class="font-medium text-jade-900">{formatCOP(price)}</span>
          </p>
        )}
      </div>
      <span
        class="mt-1 shrink-0 text-[0.68rem] uppercase tracking-[0.16em] text-jade-900/55 transition-colors group-hover:text-terracotta-700"
      >
        Ver →
      </span>
    </div>
  </a>
</article>
