# Panel: modo demostración SOLO en desarrollo. Nunca lo actives en producción.
# Requiere además que Supabase no esté configurado.
ALLOW_DEMO_MODE=false

# Supabase (Project Settings -> API)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca exponer en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (usada en enlaces de pago y correos)
SITE_URL=https://iriscandles.com

# Wompi (Panel de comercios -> Desarrolladores)
# En producción, los secretos (PRIVATE/INTEGRITY/EVENTS) se registran con
# `wrangler secret put NOMBRE` y NO se guardan en .env ni en variables de build.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Resend (emails transaccionales)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
