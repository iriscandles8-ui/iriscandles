---
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import StatCard from '../../components/admin/StatCard.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import { formatCOP, formatCompactCOP, formatDate, PROMO_TYPES } from '../../lib/admin';
import { demoPromos, demoCustomers } from '../../data/admin-demo';
import { getCustomers, getPromotions } from '../../lib/admin-data';
import { createSupabaseServer } from '../../lib/supabase-server';

export const prerender = false;

const supabase = createSupabaseServer(Astro);
const promos = supabase ? await getPromotions(supabase) : demoPromos;
const customers = supabase ? await getCustomers(supabase) : demoCustomers;

const active = promos.filter((promo) => promo.active).length;
const uses = promos.reduce((sum, promo) => sum + promo.uses, 0);
const points = customers.reduce((sum, customer) => sum + customer.points, 0);
const discountedRevenue = supabase ? 0 : 4_860_000;

const valueLabel = (promo: (typeof promos)[number]) => {
  if (promo.type === 'percent' || promo.type === 'birthday') return `${promo.value}%`;
  if (promo.type === 'points') return `${promo.value} pts`;
  return formatCOP(promo.value);
};
---

<AdminLayout title="Promociones" section="Promociones">
  <PageHeader
    eyebrow="Catálogo"
    title="Promociones"
    description="Descuentos, cumpleaños y puntos. Crea códigos, define vigencias y mide cuánto mueven las ventas."
  >
    <button type="button" slot="actions" class="admin-btn admin-btn-primary" data-new-promo>
      <AdminIcon name="plus" size={15} />
      Nuevo cupón
    </button>
  </PageHeader>

  <section class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <StatCard label="Cupones activos" value={String(active)} icon="percent" hint={`${promos.length} en total`} />
    <StatCard label="Usos acumulados" value={String(uses)} icon="tag" hint="desde el lanzamiento" />
    <StatCard label="Ventas con descuento" value={formatCompactCOP(discountedRevenue)} icon="coins" hint="últimos 90 días" />
    <StatCard label="Puntos otorgados" value={points.toLocaleString('es-CO')} icon="sparkles" hint="saldo de clientes" />
  </section>

  <section class="admin-card mt-5">
    <div class="admin-card-head">
      <div>
        <h2 class="admin-card-title">Cupones y descuentos</h2>
        <p class="mt-0.5 text-[0.7rem] text-ink/45">
          Los códigos se validan al finalizar la compra. Un uso por pedido.
        </p>
      </div>
      <span class="admin-badge" data-tone="jade">{active} activos</span>
    </div>

    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Tipo</th>
            <th class="num">Valor</th>
            <th class="num">Mínimo</th>
            <th class="num">Usos</th>
            <th>Vigencia</th>
            <th>Estado</th>
            <th class="text-right">Acciones</th>
          </tr>
        </thead>
        <tbody id="promos-body">
          {
            promos.map((promo) => (
              <tr data-promo-row={promo.id}>
                <td>
                  <span class="rounded-xs border border-dashed border-jade-900/25 bg-cream-100/60 px-2 py-1 font-mono text-[0.7rem] font-medium tracking-wide text-jade-900">
                    {promo.code}
                  </span>
                </td>
                <td class="text-ink/70" data-promo-name>{promo.name}</td>
                <td class="text-ink/55" data-promo-type>{PROMO_TYPES[promo.type] ?? promo.type}</td>
                <td class="num font-medium text-jade-900" data-promo-value>{valueLabel(promo)}</td>
                <td class="num text-ink/50" data-promo-min>{promo.minTotal ? formatCOP(promo.minTotal) : '—'}</td>
                <td class="num text-ink/60" data-promo-uses>
                  {promo.uses}{promo.maxUses ? ` / ${promo.maxUses}` : ''}
                </td>
                <td class="whitespace-nowrap text-ink/55" data-promo-ends>{promo.endsAt ? formatDate(promo.endsAt) : 'Sin vencimiento'}</td>
                <td>
                  <div class="flex items-center gap-2">
                    <button
                      type="button"
                      class:list={['admin-switch', promo.active && 'is-on']}
                      data-toggle-promo={promo.id}
                      role="switch"
                      aria-checked={promo.active}
                      aria-label={`Activar o desactivar ${promo.code}`}
                    ></button>
                    <span class="text-[0.68rem] text-ink/45" data-promo-status>{promo.active ? 'Activo' : 'Pausado'}</span>
                  </div>
                </td>
                <td>
                  <div class="flex items-center justify-end gap-1">
                    <button type="button" class="admin-icon-btn" data-edit-promo={promo.id} title="Editar" aria-label={`Editar ${promo.code}`}>
                      <AdminIcon name="edit" size={15} />
                    </button>
                    <button
                      type="button"
                      class="admin-icon-btn hover:bg-rose-50 hover:text-rose-700"
                      data-delete-promo={promo.id}
                      title="Eliminar"
                      aria-label={`Eliminar ${promo.code}`}
                    >
                      <AdminIcon name="trash" size={15} />
                    </button>
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <div class="mt-5 grid gap-5 lg:grid-cols-2">
    <section class="admin-card">
      <div class="admin-card-head">
        <div class="flex items-center gap-2.5">
          <span class="grid h-8 w-8 place-items-center rounded-xs bg-blush-200/40 text-terracotta-700">
            <AdminIcon name="gift" size={16} />
          </span>
          <div>
            <h2 class="admin-card-title">Cumpleaños</h2>
            <p class="text-[0.68rem] text-ink/45">Saludo automático con descuento</p>
          </div>
        </div>
        <button type="button" class="admin-switch is-on" data-generic-switch role="switch" aria-checked="true" aria-label="Activar promoción de cumpleaños"></button>
      </div>

      <div class="grid gap-4 p-5 sm:grid-cols-2">
        <div>
          <label class="admin-label" for="birthday-discount">Descuento</label>
          <div class="relative">
            <input id="birthday-discount" type="number" min="0" max="50" value="15" class="admin-input pr-8" />
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[0.72rem] text-ink/40">%</span>
          </div>
        </div>
        <div>
          <label class="admin-label" for="birthday-days">Días de anticipación</label>
          <input id="birthday-days" type="number" min="0" max="30" value="3" class="admin-input" />
        </div>
        <div class="sm:col-span-2">
          <label class="admin-label" for="birthday-message">Mensaje del correo</label>
          <textarea id="birthday-message" rows="2" class="admin-textarea">Feliz vuelta al sol. Te dejamos un 15% para que enciendas algo especial este mes.</textarea>
        </div>
        <div class="sm:col-span-2 flex flex-wrap items-center justify-between gap-2">
          <p class="text-[0.66rem] text-ink/40">
            3 cumpleaños este mes · código <span class="font-medium text-jade-900">CUMPLE15</span>
          </p>
          <button type="button" class="admin-btn admin-btn-outline admin-btn-sm" data-save-birthday>Guardar</button>
        </div>
      </div>
    </section>

    <section class="admin-card">
      <div class="admin-card-head">
        <div class="flex items-center gap-2.5">
          <span class="grid h-8 w-8 place-items-center rounded-xs bg-jade-50 text-jade-800">
            <AdminIcon name="sparkles" size={16} />
          </span>
          <div>
            <h2 class="admin-card-title">Puntos Iris</h2>
            <p class="text-[0.68rem] text-ink/45">Fidelización por compra</p>
          </div>
        </div>
        <button type="button" class="admin-switch is-on" data-generic-switch role="switch" aria-checked="true" aria-label="Activar programa de puntos"></button>
      </div>

      <div class="grid gap-4 p-5 sm:grid-cols-2">
        <div>
          <label class="admin-label" for="points-rate">Puntos por cada $1.000</label>
          <input id="points-rate" type="number" min="0" value="1" class="admin-input" />
        </div>
        <div>
          <label class="admin-label" for="points-value">Valor de cada punto</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[0.72rem] text-ink/40">$</span>
            <input id="points-value" type="number" min="0" step="10" value="100" class="admin-input pl-6" />
          </div>
        </div>
        <div class="sm:col-span-2">
          <label class="admin-label" for="points-min">Canje mínimo</label>
          <input id="points-min" type="number" min="0" value="500" class="admin-input" />
        </div>
        <div class="sm:col-span-2 flex flex-wrap items-center justify-between gap-2">
          <p class="text-[0.66rem] text-ink/40">Saldo total: {points.toLocaleString('es-CO')} puntos</p>
          <button type="button" class="admin-btn admin-btn-outline admin-btn-sm" data-save-points>Guardar</button>
        </div>
      </div>
    </section>
  </div>

  <section class="mt-5 border border-cream-300 bg-cream-100/40 p-5">
    <div class="flex flex-wrap items-center gap-4">
      <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xs bg-cream-50 text-jade-800">
        <AdminIcon name="percent" size={18} />
      </span>
      <div class="flex-1">
        <h2 class="font-display text-base text-jade-900">Cómo se aplican los descuentos</h2>
        <p class="mt-1 text-[0.73rem] leading-relaxed text-ink/55">
          El descuento se resta del subtotal antes del envío. Los cupones de cumpleaños y puntos no
          son acumulables entre sí. Los envíos gratis se aplican cuando el pedido supera el mínimo.
        </p>
      </div>
      <a href="/legales#terminos" target="_blank" class="admin-btn admin-btn-outline admin-btn-sm">
        Ver políticas
      </a>
    </div>
  </section>

  <!-- Modal cupón -->
  <div id="promo-modal" class="admin-modal" role="dialog" aria-modal="true" aria-labelledby="promo-modal-title">
    <form id="promo-form" class="admin-modal-panel">
      <div class="admin-modal-head">
        <div>
          <p class="text-[0.58rem] uppercase tracking-[0.18em] text-terracotta-700">Promociones</p>
          <h2 id="promo-modal-title" class="admin-card-title mt-1">Nuevo cupón</h2>
        </div>
        <button type="button" class="admin-icon-btn" data-close-modal="promo-modal" aria-label="Cerrar">
          <AdminIcon name="close" size={18} />
        </button>
      </div>

      <div class="admin-modal-body grid gap-4 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label class="admin-label" for="promo-name">Nombre interno</label>
          <input id="promo-name" data-field="name" required class="admin-input" placeholder="Especial de otoño" />
        </div>
        <div>
          <label class="admin-label" for="promo-code">Código</label>
          <input id="promo-code" data-field="code" required class="admin-input font-mono uppercase" placeholder="OTONO15" />
        </div>
        <div>
          <label class="admin-label" for="promo-type">Tipo</label>
          <select id="promo-type" data-field="type" class="admin-select">
            {Object.entries(PROMO_TYPES).map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </div>
        <div>
          <label class="admin-label" for="promo-value">Valor</label>
          <input id="promo-value" data-field="value" type="number" min="1" required class="admin-input" placeholder="15" />
          <p class="admin-hint">Porcentaje o monto en COP según el tipo.</p>
        </div>
        <div>
          <label class="admin-label" for="promo-min">Compra mínima</label>
          <input id="promo-min" data-field="min" type="number" min="0" step="1000" class="admin-input" placeholder="0" />
        </div>
        <div>
          <label class="admin-label" for="promo-max">Usos máximos</label>
          <input id="promo-max" data-field="max" type="number" min="1" class="admin-input" placeholder="Sin límite" />
        </div>
        <div>
          <label class="admin-label" for="promo-ends">Vence el</label>
          <input id="promo-ends" data-field="ends" type="date" class="admin-input" />
        </div>
        <label class="flex items-center gap-2 text-[0.75rem] text-ink/60 sm:col-span-2">
          <input type="checkbox" data-field="active" checked class="h-3.5 w-3.5 accent-jade-900" />
          Activar el cupón al guardar
        </label>
      </div>

      <div class="admin-modal-foot">
        <button type="button" class="admin-btn admin-btn-ghost" data-close-modal="promo-modal">Cancelar</button>
        <button type="submit" class="admin-btn admin-btn-primary" data-save-promo>Guardar cupón</button>
      </div>
    </form>
  </div>
</AdminLayout>

<script type="application/json" id="promos-data" set:html={JSON.stringify(promos)}></script>

<script>
  import { formatCOP, formatDate, PROMO_TYPES } from '../../lib/admin';

  type Promo = {
    id: string;
    name: string;
    code: string;
    type: string;
    value: number;
    minTotal: number;
    uses: number;
    maxUses: number | null;
    endsAt: string | null;
    active: boolean;
  };

  const promos: Promo[] = JSON.parse(document.getElementById('promos-data')?.textContent ?? '[]');
  const byId = new Map(promos.map((promo) => [promo.id, promo]));
  const tbody = document.getElementById('promos-body');
  const form = document.getElementById('promo-form') as HTMLFormElement | null;
  const modalTitle = document.getElementById('promo-modal-title');
  const saveButton = document.querySelector<HTMLButtonElement>('[data-save-promo]');
  let editingId: string | null = null;

  const valueLabel = (promo: Promo): string => {
    if (promo.type === 'percent' || promo.type === 'birthday') return `${promo.value}%`;
    if (promo.type === 'points') return `${promo.value} pts`;
    return formatCOP(promo.value);
  };

  function rowHtml(promo: Promo): string {
    return `
      <tr data-promo-row="${promo.id}">
        <td><span class="rounded-xs border border-dashed border-jade-900/25 bg-cream-100/60 px-2 py-1 font-mono text-[0.7rem] font-medium tracking-wide text-jade-900">${promo.code}</span></td>
        <td class="text-ink/70" data-promo-name>${promo.name}</td>
        <td class="text-ink/55" data-promo-type>${PROMO_TYPES[promo.type] ?? promo.type}</td>
        <td class="num font-medium text-jade-900" data-promo-value>${valueLabel(promo)}</td>
        <td class="num text-ink/50" data-promo-min>${promo.minTotal ? formatCOP(promo.minTotal) : '—'}</td>
        <td class="num text-ink/60" data-promo-uses>${promo.uses}${promo.maxUses ? ` / ${promo.maxUses}` : ''}</td>
        <td class="whitespace-nowrap text-ink/55" data-promo-ends>${promo.endsAt ? formatDate(promo.endsAt) : 'Sin vencimiento'}</td>
        <td>
          <div class="flex items-center gap-2">
            <button type="button" class="admin-switch ${promo.active ? 'is-on' : ''}" data-toggle-promo="${promo.id}" role="switch" aria-checked="${promo.active}" aria-label="Activar o desactivar ${promo.code}"></button>
            <span class="text-[0.68rem] text-ink/45" data-promo-status>${promo.active ? 'Activo' : 'Pausado'}</span>
          </div>
        </td>
        <td>
          <div class="flex items-center justify-end gap-1">
            <button type="button" class="admin-icon-btn" data-edit-promo="${promo.id}" title="Editar" aria-label="Editar ${promo.code}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4Z"/></svg>
            </button>
            <button type="button" class="admin-icon-btn hover:bg-rose-50 hover:text-rose-700" data-delete-promo="${promo.id}" title="Eliminar" aria-label="Eliminar ${promo.code}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            </button>
          </div>
        </td>
      </tr>`;
  }

  function field(name: string): HTMLInputElement | HTMLSelectElement | null {
    return form?.querySelector(`[data-field="${name}"]`) as HTMLInputElement | null;
  }

  function openModal(promo?: Promo) {
    if (!form) return;
    editingId = promo?.id ?? null;
    if (modalTitle) modalTitle.textContent = promo ? `Editar ${promo.code}` : 'Nuevo cupón';
    if (saveButton) saveButton.textContent = promo ? 'Guardar cambios' : 'Crear cupón';

    const values: Record<string, string> = {
      name: promo?.name ?? '',
      code: promo?.code ?? '',
      type: promo?.type ?? 'percent',
      value: String(promo?.value ?? 10),
      min: String(promo?.minTotal ?? 0),
      max: promo?.maxUses ? String(promo.maxUses) : '',
      ends: promo?.endsAt ?? '',
    };

    Object.entries(values).forEach(([key, value]) => {
      const input = field(key);
      if (input) input.value = value;
    });

    const active = field('active');
    if (active) (active as HTMLInputElement).checked = promo?.active ?? true;

    (window as any).openAdminModal('promo-modal');
  }

  tbody?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    const toggle = target.closest<HTMLButtonElement>('[data-toggle-promo]');
    if (toggle) {
      const promo = byId.get(toggle.dataset.togglePromo ?? '');
      if (!promo) return;
      promo.active = !promo.active;
      toggle.classList.toggle('is-on', promo.active);
      toggle.setAttribute('aria-checked', String(promo.active));
      const label = toggle.parentElement?.querySelector<HTMLElement>('[data-promo-status]');
      if (label) label.textContent = promo.active ? 'Activo' : 'Pausado';
      (window as any).adminToast(`Cupón ${promo.code} ${promo.active ? 'activado' : 'pausado'} (demo).`);
      return;
    }

    const edit = target.closest<HTMLButtonElement>('[data-edit-promo]');
    if (edit) {
      const promo = byId.get(edit.dataset.editPromo ?? '');
      if (promo) openModal(promo);
      return;
    }

    const remove = target.closest<HTMLButtonElement>('[data-delete-promo]');
    if (remove) {
      const promo = byId.get(remove.dataset.deletePromo ?? '');
      if (!promo) return;
      if (!window.confirm(`¿Eliminar el cupón ${promo.code}?`)) return;
      byId.delete(promo.id);
      const index = promos.findIndex((item) => item.id === promo.id);
      if (index >= 0) promos.splice(index, 1);
      tbody?.querySelector(`tr[data-promo-row="${promo.id}"]`)?.remove();
      (window as any).adminToast(`Cupón ${promo.code} eliminado (demo).`, 'warn');
    }
  });

  document.querySelector('[data-new-promo]')?.addEventListener('click', () => openModal());

  document.querySelectorAll<HTMLElement>('[data-close-modal]').forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.dataset.closeModal;
      if (id) (window as any).closeAdminModal(id);
    });
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const code = (field('code')?.value ?? '').trim().toUpperCase();
    const name = (field('name')?.value ?? '').trim();
    if (!code || !name) return;

    const promo: Promo = {
      id: editingId ?? `promo-${Date.now()}`,
      name,
      code,
      type: field('type')?.value ?? 'percent',
      value: Number(field('value')?.value ?? 0),
      minTotal: Number(field('min')?.value ?? 0),
      uses: editingId ? byId.get(editingId)?.uses ?? 0 : 0,
      maxUses: field('max')?.value ? Number(field('max')?.value) : null,
      endsAt: field('ends')?.value || null,
      active: (field('active') as HTMLInputElement | null)?.checked ?? true,
    };

    if (editingId) {
      const existing = byId.get(editingId);
      if (existing) {
        Object.assign(existing, promo);
        const row = tbody?.querySelector<HTMLTableRowElement>(`tr[data-promo-row="${existing.id}"]`);
        if (row) row.outerHTML = rowHtml(existing);
      }
      (window as any).adminToast(`Cupón ${promo.code} actualizado (demo).`);
    } else {
      promos.push(promo);
      byId.set(promo.id, promo);
      tbody?.insertAdjacentHTML('afterbegin', rowHtml(promo));
      (window as any).adminToast(`Cupón ${promo.code} creado (demo).`);
    }

    (window as any).closeAdminModal('promo-modal');
  });

  document.querySelectorAll<HTMLElement>('[data-generic-switch]').forEach((button) => {
    button.addEventListener('click', () => {
      const on = button.classList.toggle('is-on');
      button.setAttribute('aria-checked', String(on));
      (window as any).adminToast(on ? 'Automatización activada (demo).' : 'Automatización pausada (demo).', on ? 'ok' : 'warn');
    });
  });

  document.querySelector('[data-save-birthday]')?.addEventListener('click', () => {
    (window as any).adminToast('Configuración de cumpleaños guardada (demo).');
  });

  document.querySelector('[data-save-points]')?.addEventListener('click', () => {
    (window as any).adminToast('Programa de puntos actualizado (demo).');
  });
</script>
