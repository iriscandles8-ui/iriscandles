---
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import { formatDate, isDemoMode, ROLE_LABELS, type AdminRole } from '../../lib/admin';
import { demoShippingZones, demoAdminUsers } from '../../data/admin-demo';
import { getAdminUsers, getShippingZones } from '../../lib/admin-data';
import { createSupabaseServer } from '../../lib/supabase-server';
import { isResendConfigured } from '../../lib/resend';

export const prerender = false;

const supabase = createSupabaseServer(Astro);
const shippingZones = supabase ? await getShippingZones(supabase) : demoShippingZones;
const adminUsers = supabase ? await getAdminUsers(supabase) : demoAdminUsers;

const tabs = [
  { id: 'tienda', label: 'Tienda', icon: 'home' },
  { id: 'envios', label: 'Envíos', icon: 'truck' },
  { id: 'pagos', label: 'Pagos', icon: 'card' },
  { id: 'permisos', label: 'Permisos', icon: 'lock' },
  { id: 'politicas', label: 'Políticas', icon: 'check' },
  { id: 'conexion', label: 'Conexión', icon: 'settings' },
];

const roles: AdminRole[] = ['owner', 'admin', 'manager', 'viewer'];

const paymentMethods = [
  { id: 'pse', label: 'PSE', hint: 'Débito desde bancos colombianos', active: true },
  { id: 'nequi', label: 'Nequi', hint: 'Billetera digital', active: true },
  { id: 'daviplata', label: 'Daviplata', hint: 'Billetera digital', active: true },
  { id: 'tarjetas', label: 'Tarjetas', hint: 'Crédito y débito', active: true },
];

const permissionModules = [
  { id: 'orders', label: 'Pedidos' },
  { id: 'products', label: 'Productos' },
  { id: 'inventory', label: 'Inventario' },
  { id: 'customers', label: 'Clientes' },
  { id: 'reviews', label: 'Reseñas' },
  { id: 'stats', label: 'Estadísticas' },
  { id: 'promotions', label: 'Promociones' },
  { id: 'settings', label: 'Configuración' },
];

const connectionItems = [
  {
    id: 'supabase',
    name: 'Supabase',
    role: 'Base de datos, autenticación y archivos',
    env: ['PUBLIC_SUPABASE_URL', 'PUBLIC_SUPABASE_ANON_KEY'],
    configured: !isDemoMode,
    href: 'https://supabase.com/dashboard',
  },
  {
    id: 'wompi',
    name: 'Wompi',
    role: 'Pagos con PSE, Nequi, Daviplata y tarjetas',
    env: ['WOMPI_PUBLIC_KEY', 'WOMPI_EVENTS_SECRET'],
    configured: false,
    href: 'https://comercios.wompi.co',
  },
  {
    id: 'resend',
    name: 'Resend',
    role: 'Correos transaccionales y campañas',
    env: ['RESEND_API_KEY', 'RESEND_FROM_EMAIL'],
    configured: await isResendConfigured(),
    href: 'https://resend.com/api-keys',
  },
  {
    id: 'cloudflare',
    name: 'Cloudflare Pages',
    role: 'Hosting del sitio público y del panel',
    env: [],
    configured: false,
    href: 'https://dash.cloudflare.com',
  },
];

const zones = shippingZones;
const staff = adminUsers;
---


<AdminLayout title="Configuración" section="Configuración">
  <PageHeader
    eyebrow="Negocio"
    title="Configuración"
    description="Los datos que sostienen la tienda: identidad, envíos, pagos, accesos del equipo y conexiones técnicas."
  >
    <button type="button" slot="actions" class="admin-btn admin-btn-outline" data-export-settings>
      <AdminIcon name="download" size={14} />
      Exportar configuración
    </button>
  </PageHeader>

  {
    isDemoMode && (
      <div class="mb-5 flex flex-wrap items-start gap-3 border border-amber-200 bg-amber-50 px-4 py-3 text-[0.74rem] leading-relaxed text-amber-900">
        <AdminIcon name="alert" size={16} class="mt-0.5 shrink-0" />
        <p class="flex-1">
          <strong class="font-semibold">Estás en modo demostración.</strong> Los cambios de esta
          pantalla no se guardan. Conecta Supabase para que la configuración quede persistida en la
          tabla <code>settings</code>.
        </p>
        <a href="#conexion" class="admin-btn admin-btn-outline admin-btn-sm" data-config-goto="conexion">
          Ver conexión
        </a>
      </div>
    )
  }

  <section class="admin-card">
    <div class="admin-tabs px-2" role="tablist" aria-label="Secciones de configuración">
      {
        tabs.map((tab) => (
          <button
            type="button"
            class:list={['admin-tab', tab.id === 'tienda' && 'is-active']}
            data-config-tab={tab.id}
            role="tab"
            aria-selected={tab.id === 'tienda'}
          >
            <span class="inline-flex items-center gap-1.5">
              <AdminIcon name={tab.icon} size={14} />
              {tab.label}
            </span>
          </button>
        ))
      }
    </div>

    <!-- ------------------------------ Tienda ------------------------------ -->
    <div data-config-panel="tienda">
      <div class="grid gap-6 p-5 lg:grid-cols-[1.4fr_1fr] lg:p-6">
        <div class="space-y-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="admin-label" for="store-name">Nombre de la tienda</label>
              <input id="store-name" class="admin-input" value="Iris Candles" />
            </div>
            <div>
              <label class="admin-label" for="store-email">Correo de contacto</label>
              <input id="store-email" type="email" class="admin-input" value="hola@iriscandles.com" />
            </div>
            <div>
              <label class="admin-label" for="store-whatsapp">WhatsApp</label>
              <input id="store-whatsapp" class="admin-input" placeholder="+57 300 000 0000" value="" />
              <p class="admin-hint">Se usa en el botón de ayuda del sitio público.</p>
            </div>
            <div>
              <label class="admin-label" for="store-city">Ciudad del taller</label>
              <input id="store-city" class="admin-input" value="Bogotá" />
            </div>
            <div>
              <label class="admin-label" for="store-country">País</label>
              <input id="store-country" class="admin-input" value="Colombia" />
            </div>
            <div>
              <label class="admin-label" for="store-currency">Moneda</label>
              <select id="store-currency" class="admin-select">
                <option value="COP" selected>COP · Peso colombiano</option>
              </select>
              <p class="admin-hint">Precios con IVA incluido, sin decimales.</p>
            </div>
          </div>

          <div>
            <label class="admin-label" for="store-announcement">Anuncio de la barra superior</label>
            <input
              id="store-announcement"
              class="admin-input"
              value="Envío gratis desde $180.000 en ciudades principales"
            />
          </div>

          <div>
            <label class="admin-label" for="store-about">Descripción corta</label>
            <textarea id="store-about" rows="3" class="admin-textarea">Velas artesanales hechas a mano en Colombia. Aromas que acompañan la casa y las tardes lentas.</textarea>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-2 border-t border-cream-300 pt-4">
            <p class="text-[0.68rem] text-ink/45">Última actualización: {formatDate('2026-11-11')}</p>
            <button type="button" class="admin-btn admin-btn-primary" data-save="Configuración de la tienda guardada">
              Guardar cambios
            </button>
          </div>
        </div>

        <aside class="space-y-4">
          <div class="border border-cream-300 bg-cream-50 p-4">
            <p class="text-[0.58rem] uppercase tracking-[0.16em] text-jade-900/45">Identidad visual</p>
            <div class="mt-3 flex items-center gap-3">
              <img
                src="/brand/logo-iris-candles.svg"
                alt="Logotipo actual de Iris Candles"
                class="h-16 w-16 rounded-xs border border-cream-300 bg-cream-50 object-contain p-1"
              />
              <div class="min-w-0">
                <p class="text-[0.78rem] font-medium text-jade-900">logo-iris-candles.svg</p>
                <p class="text-[0.66rem] text-ink/45">SVG · fondo transparente</p>
                <button type="button" class="admin-btn admin-btn-outline admin-btn-sm mt-2" data-upload-logo>
                  Reemplazar logotipo
                </button>
              </div>
            </div>
            <p class="admin-hint">
              Recomendado 800 × 800 px. El logotipo se usa en la tienda, el panel y los correos.
            </p>
          </div>

          <div class="border border-cream-300 bg-cream-50 p-4">
            <p class="text-[0.58rem] uppercase tracking-[0.16em] text-jade-900/45">Dominio</p>
            <p class="mt-2 text-[0.78rem] font-medium text-jade-900">iriscandles.com</p>
            <p class="text-[0.66rem] leading-relaxed text-ink/45">
              Dominio provisional. Cuando lo compres, actualízalo en Cloudflare Pages y en
              <code class="text-jade-900">astro.config.mjs</code>.
            </p>
          </div>

          <div class="border border-terracotta-600/25 bg-terracotta-600/[0.06] p-4">
            <p class="text-[0.58rem] uppercase tracking-[0.16em] text-terracotta-700">Pendiente</p>
            <p class="mt-2 text-[0.74rem] leading-relaxed text-ink/60">
              Faltan precios finales y fotografía de catálogo. Mientras tanto, la tienda usa
              ilustraciones de referencia.
            </p>
          </div>
        </aside>
      </div>
    </div>

    <!-- ------------------------------ Envíos ------------------------------ -->
    <div data-config-panel="envios" hidden>
      <div class="grid gap-4 border-b border-cream-300 p-5 sm:grid-cols-3 lg:px-6">
        <div>
          <label class="admin-label" for="shipping-free">Envío gratis desde</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[0.72rem] text-ink/40">$</span>
            <input id="shipping-free" type="number" min="0" step="1000" value="180000" class="admin-input pl-6" />
          </div>
          <p class="admin-hint">Aplica sobre el subtotal antes de descuentos.</p>
        </div>
        <div>
          <label class="admin-label" for="shipping-eta">Tiempo de entrega por defecto</label>
          <input id="shipping-eta" class="admin-input" value="1–3 días hábiles" />
        </div>
        <div>
          <label class="admin-label" for="shipping-carrier">Transportadora principal</label>
          <input id="shipping-carrier" class="admin-input" value="Envía" />
        </div>
      </div>

      <div class="admin-card-head">
        <div>
          <h2 class="admin-card-title">Zonas de envío</h2>
          <p class="mt-0.5 text-[0.7rem] text-ink/45">
            Tarifa base más costo por kilo. El envío gratis se aplica si el pedido supera el mínimo de la zona.
          </p>
        </div>
        <button type="button" class="admin-btn admin-btn-outline admin-btn-sm" data-add-zone>
          <AdminIcon name="plus" size={13} />
          Nueva zona
        </button>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Zona</th>
              <th class="num">Tarifa base</th>
              <th class="num">Por kg</th>
              <th>Entrega</th>
              <th class="num">Gratis desde</th>
              <th class="text-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="zones-body">
            {
              zones.map((zone) => (
                <tr data-zone-row={zone.id}>
                  <td>
                    <input class="admin-input py-1.5 text-[0.78rem]" value={zone.name} aria-label={`Nombre de ${zone.name}`} />
                  </td>
                  <td class="num">
                    <input
                      type="number"
                      min="0"
                      step="1000"
                      class="admin-input py-1.5 text-right text-[0.78rem]"
                      value={zone.base}
                      aria-label={`Tarifa base de ${zone.name}`}
                    />
                  </td>
                  <td class="num">
                    <input
                      type="number"
                      min="0"
                      step="500"
                      class="admin-input py-1.5 text-right text-[0.78rem]"
                      value={zone.perKg}
                      aria-label={`Costo por kilo de ${zone.name}`}
                    />
                  </td>
                  <td>
                    <input class="admin-input py-1.5 text-[0.78rem]" value={zone.eta} aria-label={`Tiempo de entrega de ${zone.name}`} />
                  </td>
                  <td class="num">
                    <input
                      type="number"
                      min="0"
                      step="1000"
                      class="admin-input py-1.5 text-right text-[0.78rem]"
                      value={zone.freeFrom}
                      aria-label={`Envío gratis desde de ${zone.name}`}
                    />
                  </td>
                  <td class="text-right">
                    <button
                      type="button"
                      class="admin-icon-btn hover:bg-rose-50 hover:text-rose-700"
                      data-delete-zone={zone.id}
                      aria-label={`Eliminar zona ${zone.name}`}
                    >
                      <AdminIcon name="trash" size={15} />
                    </button>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-2 border-t border-cream-300 px-4 py-3">
        <p class="text-[0.66rem] text-ink/40">
          Las tarifas se guardan en <code class="text-jade-900">shipping_zones</code> y se muestran en el checkout.
        </p>
        <button type="button" class="admin-btn admin-btn-primary admin-btn-sm" data-save="Tarifas de envío guardadas">
          Guardar tarifas
        </button>
      </div>
    </div>

    <!-- ------------------------------ Pagos ------------------------------ -->
    <div data-config-panel="pagos" hidden>
      <div class="grid gap-6 p-5 lg:grid-cols-[1.4fr_1fr] lg:p-6">
        <div class="space-y-5">
          <div>
            <h2 class="admin-card-title">Pasarela de pago</h2>
            <p class="mt-0.5 text-[0.72rem] text-ink/45">
              Hoy los pagos se confirman manualmente desde <strong class="font-medium text-jade-900">Pedidos</strong>.
              Al conectar Wompi, la pasarela cobra y transfiere a tu cuenta bancaria, sin mensualidad fija.
            </p>
            <div class="mt-3 flex items-center gap-3 border border-jade-900/20 bg-jade-50/60 p-3.5">
              <span class="grid h-9 w-9 place-items-center rounded-xs bg-jade-900 text-cream-50">
                <AdminIcon name="card" size={17} />
              </span>
              <div class="flex-1">
                <p class="text-[0.82rem] font-medium text-jade-900">Wompi · Web Checkout</p>
                <p class="text-[0.66rem] text-ink/45">Comisión ≈ 2,65% + $700 + IVA por transacción</p>
              </div>
              <span class="admin-badge" data-tone="amber">Sin conectar</span>
            </div>
          </div>

          <div>
            <p class="admin-label">Métodos habilitados</p>
            <div class="grid gap-2 sm:grid-cols-2">
              {
                paymentMethods.map((method) => (
                  <label class="flex cursor-pointer items-center gap-3 border border-cream-300 bg-cream-50 px-3 py-2.5">
                    <input type="checkbox" checked={method.active} class="h-3.5 w-3.5 accent-jade-900" data-payment-method={method.id} />
                    <span class="flex-1">
                      <span class="block text-[0.78rem] font-medium text-jade-900">{method.label}</span>
                      <span class="block text-[0.64rem] text-ink/45">{method.hint}</span>
                    </span>
                  </label>
                ))
              }
            </div>
            <p class="admin-hint">Nequi y Daviplata son los más usados. PSE y tarjeta se activan al conectar Wompi.</p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="admin-label" for="payments-currency">Moneda de cobro</label>
              <select id="payments-currency" class="admin-select">
                <option value="COP" selected>COP</option>
              </select>
            </div>
            <div>
              <label class="admin-label" for="payments-mode">Entorno</label>
              <select id="payments-mode" class="admin-select">
                <option value="sandbox" selected>Pruebas (sandbox)</option>
                <option value="production">Producción</option>
              </select>
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-2 border-t border-cream-300 pt-4">
            <p class="text-[0.66rem] text-ink/45">Los pagos se confirman por webhook firmado.</p>
            <button type="button" class="admin-btn admin-btn-primary" data-save="Configuración de pagos guardada">
              Guardar pagos
            </button>
          </div>
        </div>

        <aside class="space-y-4">
          <div class="border border-cream-300 bg-cream-50 p-4">
            <p class="text-[0.58rem] uppercase tracking-[0.16em] text-jade-900/45">Requisitos para activar Wompi</p>
            <ul class="mt-2.5 space-y-2 text-[0.72rem] leading-relaxed text-ink/55">
              {[
                'RUT actualizado de la persona natural o jurídica',
                'Cuenta bancaria a nombre del titular del RUT',
                'Cámara de comercio (si aplica)',
                'Correo y teléfono de contacto',
              ].map((item) => (
                <li class="flex gap-2">
                  <AdminIcon name="check" size={13} class="mt-0.5 shrink-0 text-jade-700" />
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div class="border border-cream-300 bg-cream-50 p-4">
            <p class="text-[0.58rem] uppercase tracking-[0.16em] text-jade-900/45">Flujo del pago</p>
            <ol class="mt-2.5 space-y-2 text-[0.72rem] leading-relaxed text-ink/55">
              <li>1. El cliente elige productos y llega al checkout.</li>
              <li>2. Se crea la orden en estado <code class="text-jade-900">pending</code>.</li>
              <li>3. Hoy: confirmas el pago a mano en Pedidos y se descuenta el stock.</li>
              <li>4. Con Wompi: la pasarela cobra con PSE, Nequi, Daviplata o tarjeta.</li>
              <li>5. El webhook confirma el pago y Resend envía el correo (al conectar ambos).</li>
            </ol>
          </div>
        </aside>
      </div>
    </div>

    <!-- ------------------------------ Permisos ------------------------------ -->
    <div data-config-panel="permisos" hidden>
      <div class="admin-card-head">
        <div>
          <h2 class="admin-card-title">Equipo autorizado</h2>
          <p class="mt-0.5 text-[0.7rem] text-ink/45">
            Solo las cuentas de esta lista pueden entrar al panel. El acceso se valida con Supabase Auth y RLS.
          </p>
        </div>
        <button type="button" class="admin-btn admin-btn-primary admin-btn-sm" data-invite>
          <AdminIcon name="plus" size={13} />
          Invitar persona
        </button>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Persona</th>
              <th>Rol</th>
              <th>Última sesión</th>
              <th>Estado</th>
              <th class="text-right">Acciones</th>
            </tr>
          </thead>
          <tbody>
            {
              staff.map((member) => (
                <tr data-staff-row={member.id}>
                  <td>
                    <div class="flex items-center gap-2.5">
                      <span class="admin-avatar">
                        {member.name
                          .split(' ')
                          .filter(Boolean)
                          .slice(0, 2)
                          .map((part) => part[0]?.toUpperCase() ?? '')
                          .join('')}
                      </span>
                      <div>
                        <p class="font-medium text-jade-900">{member.name}</p>
                        <p class="text-[0.66rem] text-ink/40">{member.email}</p>
                      </div>
                    </div>
                  </td>
                  <td>
                    <select class="admin-select max-w-[10rem] py-1 text-[0.74rem]" data-staff-role aria-label={`Rol de ${member.name}`}>
                      {roles.map((role) => (
                        <option value={role} selected={role === member.role}>
                          {ROLE_LABELS[role]}
                        </option>
                      ))}
                    </select>
                  </td>
                  <td class="whitespace-nowrap text-ink/55">{formatDate(member.lastSeen)}</td>
                  <td>
                    <div class="flex items-center gap-2">
                      <button
                        type="button"
                        class:list={['admin-switch', member.active && 'is-on']}
                        data-staff-toggle
                        role="switch"
                        aria-checked={member.active}
                        aria-label={`Activar o desactivar a ${member.name}`}
                      ></button>
                      <span class="text-[0.68rem] text-ink/45" data-staff-status>
                        {member.active ? 'Activo' : 'Suspendido'}
                      </span>
                    </div>
                  </td>
                  <td class="text-right">
                    <button
                      type="button"
                      class="admin-icon-btn hover:bg-rose-50 hover:text-rose-700"
                      data-staff-remove
                      aria-label={`Quitar a ${member.name}`}
                      disabled={member.role === 'owner'}
                    >
                      <AdminIcon name="trash" size={15} />
                    </button>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="grid gap-5 border-t border-cream-300 p-5 lg:grid-cols-[1.2fr_1fr] lg:p-6">
        <div>
          <h3 class="font-display text-base text-jade-900">Qué puede hacer cada rol</h3>
          <div class="mt-3 space-y-2">
            {[
              { role: 'owner', text: 'Acceso total, incluida la gestión del equipo y la configuración.' },
              { role: 'admin', text: 'Todo el catálogo, pedidos, clientes y estadísticas. No gestiona propietarias.' },
              { role: 'manager', text: 'Operación diaria: pedidos, inventario, reseñas y promociones.' },
              { role: 'viewer', text: 'Solo lectura de pedidos, clientes y estadísticas.' },
            ].map((item) => (
              <div class="flex gap-3 border border-cream-300 bg-cream-50 px-3 py-2.5">
                <span class="admin-badge mt-0.5" data-tone={item.role === 'owner' ? 'jade' : item.role === 'admin' ? 'blue' : item.role === 'manager' ? 'terracotta' : 'slate'}>
                  {ROLE_LABELS[item.role as AdminRole]}
                </span>
                <p class="flex-1 text-[0.72rem] leading-relaxed text-ink/55">{item.text}</p>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h3 class="font-display text-base text-jade-900">Módulos del panel</h3>
          <p class="mt-1 text-[0.7rem] leading-relaxed text-ink/45">
            Permisos finos por módulo para el rol Gestión. La propietaria y administración siempre tienen acceso completo.
          </p>
          <div class="mt-3 grid grid-cols-2 gap-1.5">
            {
              permissionModules.map((module) => (
                <label class="flex items-center gap-2 border border-cream-300 bg-cream-50 px-2.5 py-2 text-[0.72rem] text-ink/65">
                  <input type="checkbox" checked class="h-3.5 w-3.5 accent-jade-900" data-permission={module.id} />
                  {module.label}
                </label>
              ))
            }
          </div>
          <button type="button" class="admin-btn admin-btn-outline admin-btn-sm mt-3 w-full" data-save="Permisos del equipo guardados">
            Guardar permisos
          </button>
        </div>
      </div>
    </div>

    <!-- ------------------------------ Políticas ------------------------------ -->
    <div data-config-panel="politicas" hidden>
      <div class="grid gap-6 p-5 lg:grid-cols-2 lg:p-6">
        <div class="space-y-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="admin-label" for="policy-returns">Días para devoluciones</label>
              <input id="policy-returns" type="number" min="1" max="30" value="5" class="admin-input" />
            </div>
            <div>
              <label class="admin-label" for="policy-warranty">Garantía</label>
              <input id="policy-warranty" class="admin-input" value="Reemplazo por daños en transporte" />
            </div>
            <div>
              <label class="admin-label" for="policy-privacy">Versión de privacidad</label>
