---
import Base from '../layouts/Base.astro';
import { formatCOP, pricesAreProvisional, shipping } from '../data/pricing';

// SSR para que el carrito use el catálogo vigente (no el del build).
export const prerender = false;
---

<Base
  title="Carrito · Iris Candles"
  description="Revisa tus velas, ajusta cantidades y continúa al pago coordinado por WhatsApp."
  noindex
>
  <section class="py-10 lg:py-14">
    <div class="container-iris">
      <nav aria-label="Ruta de navegación" class="text-[0.68rem] uppercase tracking-[0.14em] text-jade-900/75">
        <a href="/" class="hover:text-jade-900">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/tienda" class="hover:text-jade-900">Tienda</a>
        <span class="mx-2">/</span>
        <span class="text-jade-900/85">Carrito</span>
      </nav>

      <div class="mt-6 flex flex-wrap items-end justify-between gap-3 border-b border-cream-300 pb-6">
        <div>
          <p class="eyebrow text-terracotta-700">Tu selección</p>
          <h1 class="mt-3 font-display text-3xl leading-tight text-jade-900 sm:text-4xl">
            Carrito
            <span class="ml-1 align-middle text-base tracking-normal text-jade-900/75" data-item-count></span>
          </h1>
        </div>
        <p class="text-[0.72rem] text-ink/70">Precios en COP con IVA incluido.</p>
      </div>

      <noscript>
        <div class="mt-8 border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
          El carrito necesita JavaScript para funcionar. Actívalo o escríbenos a
          <a class="underline" href="mailto:hola@iriscandles.com">hola@iriscandles.com</a>.
        </div>
      </noscript>

      <!-- Cargando -->
      <div data-cart-loading class="mt-8 grid gap-8 lg:grid-cols-[1.6fr_1fr]">
        <div class="space-y-4" aria-hidden="true">
          {
            [0, 1].map(() => (
              <div class="flex animate-pulse gap-4 border border-cream-300 bg-cream-50 p-4">
                <div class="h-24 w-24 shrink-0 bg-cream-200/70"></div>
                <div class="flex-1 space-y-2 py-1">
                  <div class="h-3 w-24 bg-cream-200/70"></div>
                  <div class="h-4 w-40 bg-cream-200/70"></div>
                  <div class="h-3 w-32 bg-cream-200/70"></div>
                </div>
              </div>
            ))
          }
        </div>
        <div class="h-56 animate-pulse border border-cream-300 bg-cream-100/40" aria-hidden="true"></div>
        <p class="sr-only" role="status">Cargando tu carrito…</p>
      </div>

      <!-- Vacío -->
      <div data-cart-empty hidden class="py-16 text-center sm:py-24">
        <span class="mx-auto grid h-16 w-16 place-items-center rounded-full border border-cream-300 bg-cream-100/60">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="text-jade-900/50">
            <path
              d="M6 7h12l-1.2 12.1a1.5 1.5 0 0 1-1.5 1.4H8.7a1.5 1.5 0 0 1-1.5-1.4L6 7Z"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linejoin="round"></path>
            <path
              d="M9 7V5.6A3 3 0 0 1 12 3a3 3 0 0 1 3 2.6V7"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"></path>
          </svg>
        </span>
        <h2 class="mt-6 font-display text-2xl text-jade-900 sm:text-3xl">Tu carrito está vacío</h2>
        <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-ink/75">
          Explora las cuatro colecciones y elige el tamaño que mejor acompañe tu espacio.
          Si no sabes cuál elegir, el test de aroma te ayuda en menos de un minuto.
        </p>
        <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/tienda" class="btn-primary">Ver la tienda</a>
          <a href="/encuentra-tu-aroma" class="btn-outline">Encontrar mi aroma</a>
        </div>
      </div>

      <!-- Con productos -->
      <div data-cart-content hidden class="mt-8 grid gap-10 lg:grid-cols-[1.6fr_1fr] lg:gap-14">
        <div>
          <div class="flex items-center justify-between gap-3 border-b border-cream-300 pb-3">
            <h2 class="text-[0.68rem] uppercase tracking-[0.16em] text-jade-900/80">Productos</h2>
            <button
              type="button"
              class="text-[0.68rem] text-ink/70 underline underline-offset-2 transition-colors hover:text-terracotta-700"
              data-clear-cart
            >
              Vaciar carrito
            </button>
          </div>

          <div data-cart-lines class="divide-y divide-cream-300"></div>

          <a
            href="/tienda"
            class="mt-6 inline-flex items-center gap-2 text-[0.78rem] font-medium text-jade-900 transition-colors hover:text-terracotta-700"
          >
            <span aria-hidden="true">←</span>
            Seguir comprando
          </a>
        </div>

        <aside class="lg:sticky lg:top-28 lg:self-start">
          <div class="border border-cream-300 bg-cream-100/40 p-5 sm:p-6">
            <h2 class="font-display text-xl text-jade-900">Resumen</h2>

            <dl class="mt-5 space-y-3 text-sm">
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-ink/75">Subtotal</dt>
                <dd class="font-medium text-jade-900" data-subtotal>—</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-ink/75">Envío estimado</dt>
                <dd class="font-medium text-jade-900" data-shipping>—</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4 text-jade-700" data-discount-row hidden>
                <dt class="text-jade-700">Descuento <span data-discount-code></span></dt>
                <dd class="font-medium" data-discount>—</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4 border-t border-cream-300 pt-3">
                <dt class="font-medium text-jade-900">Total</dt>
                <dd class="font-display text-xl text-jade-900" data-total>—</dd>
              </div>
            </dl>

            <div class="mt-5 border-t border-cream-300 pt-4">
              <label for="coupon-code" class="text-[0.68rem] font-medium text-jade-900">
                ¿Tienes un código de descuento?
              </label>
              <div class="mt-2 flex gap-2">
                <input
                  id="coupon-code"
                  type="text"
                  autocomplete="off"
                  spellcheck="false"
                  maxlength="40"
                  placeholder="Ej. BIENVENIDA10"
                  class="field min-w-0 flex-1 uppercase"
                />
                <button type="button" class="btn-outline shrink-0" data-apply-coupon>Aplicar</button>
              </div>
              <p data-coupon-message hidden class="mt-2 text-[0.68rem] leading-relaxed" role="status"></p>
              <div data-coupon-applied hidden class="mt-3 flex items-center justify-between gap-2 border border-dashed border-jade-900/25 bg-cream-100/60 px-3 py-2">
                <div class="min-w-0">
                  <p class="text-[0.6rem] uppercase tracking-[0.12em] text-jade-900/60">Cupón aplicado</p>
                  <p class="truncate font-mono text-[0.72rem] font-medium text-jade-900" data-coupon-label></p>
                </div>
                <button type="button" class="shrink-0 text-[0.66rem] text-ink/70 underline underline-offset-2 hover:text-terracotta-700" data-remove-coupon>
                  Quitar
                </button>
              </div>
            </div>

            <div class="mt-5" data-free-progress>
              <div class="flex items-baseline justify-between gap-3 text-[0.66rem] text-ink/70">
                <span data-free-label></span>
                <span data-free-amount></span>
              </div>
              <div class="mt-2 h-1 w-full overflow-hidden bg-cream-300">
                <div class="h-full bg-jade-700 transition-[width] duration-500 ease-soft" data-free-bar style="width:0%"></div>
              </div>
            </div>

            <a href="/checkout" class="btn-primary mt-6 w-full" data-checkout>
              Continuar al pago
            </a>

            <p class="mt-3 text-center text-[0.66rem] leading-relaxed text-ink/70">
              Pago coordinado por WhatsApp: Nequi, Daviplata o transferencia.
            </p>

            <ul class="mt-5 space-y-2 border-t border-cream-300 pt-4 text-[0.7rem] text-ink/70">
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-terracotta-600"></span>
                Envío gratis desde {formatCOP(shipping.freeFromCop)} · {shipping.freeCitiesNote}
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-terracotta-600"></span>
                Despacho en {shipping.etaLabel} después del pago
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-terracotta-600"></span>
                Cambios y reemplazos dentro de los 5 días siguientes
              </li>
            </ul>

            {
              pricesAreProvisional && (
                <p class="mt-4 border-l-2 border-terracotta-600/40 pl-3 text-[0.66rem] leading-relaxed text-ink/70">
                  Los precios son de referencia mientras se publican los definitivos. El cobro
                  automático se activa al conectar la pasarela de pagos.
                </p>
              )
            }
          </div>

          <p class="mt-3 flex items-center justify-center gap-1.5 text-[0.64rem] text-ink/70">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="4" y="10" width="16" height="10" rx="2" stroke="currentColor" stroke-width="1.6"></rect>
              <path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.6"></path>
            </svg>
            Conexión cifrada · Confirmación manual del pedido
          </p>
        </aside>
      </div>

      <p class="sr-only" role="status" aria-live="polite" data-cart-announcer></p>
    </div>
  </section>
</Base>

<script>
  import {
    CART_EVENT,
    clearCart,
    clearCoupon,
    formatCOP,
    getLines,
    getTotals,
    readCart,
    readCoupon,
    removeFromCart,
    saveCoupon,
    setQty,
    type StoredCoupon,
  } from '../lib/cart';
  import { couponDiscountCop } from '../lib/coupons';
  import { shipping } from '../data/pricing';

  const loading = document.querySelector<HTMLElement>('[data-cart-loading]');
  const empty = document.querySelector<HTMLElement>('[data-cart-empty]');
  const content = document.querySelector<HTMLElement>('[data-cart-content]');
  const linesHost = document.querySelector<HTMLElement>('[data-cart-lines]');
  const countLabel = document.querySelector<HTMLElement>('[data-item-count]');
  const announcer = document.querySelector<HTMLElement>('[data-cart-announcer]');
  const subtotalEl = document.querySelector<HTMLElement>('[data-subtotal]');
  const shippingEl = document.querySelector<HTMLElement>('[data-shipping]');
  const totalEl = document.querySelector<HTMLElement>('[data-total]');
  const freeLabel = document.querySelector<HTMLElement>('[data-free-label]');
  const freeAmount = document.querySelector<HTMLElement>('[data-free-amount]');
  const freeBar = document.querySelector<HTMLElement>('[data-free-bar]');
  const couponInput = document.querySelector<HTMLInputElement>('#coupon-code');
  const applyCouponButton = document.querySelector<HTMLButtonElement>('[data-apply-coupon]');
  const couponMessage = document.querySelector<HTMLElement>('[data-coupon-message]');
  const couponApplied = document.querySelector<HTMLElement>('[data-coupon-applied]');
  const couponLabelEl = document.querySelector<HTMLElement>('[data-coupon-label]');
  const discountRow = document.querySelector<HTMLElement>('[data-discount-row]');
  const discountEl = document.querySelector<HTMLElement>('[data-discount]');
  const discountCodeEl = document.querySelector<HTMLElement>('[data-discount-code]');

  function escapeHtml(value: string): string {
    return value.replace(/[&<>"']/g, (char) => {
      const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
      return map[char] ?? char;
    });
  }

  function lineTemplate(line: ReturnType<typeof getLines>[number]): string {
    const collection = line.slug;
    const number = line.collectionNumber;
    const accent = line.accent;
    const soft = line.soft;

    return `
      <article class="grid grid-cols-[76px_1fr] gap-4 py-5 sm:grid-cols-[96px_1fr_auto]" data-line="${escapeHtml(line.sku)}">
        <a href="/producto/${collection}" class="block aspect-square overflow-hidden border border-cream-300 bg-cream-100" aria-hidden="true" tabindex="-1">
          <div class="flex h-full w-full flex-col justify-between p-2" style="background:linear-gradient(160deg, #fbf7ee 0%, ${soft} 100%)">
            <span class="font-display text-[0.6rem] tracking-[0.16em] text-jade-900/35">${escapeHtml(number)}</span>
            <span class="h-1.5 w-1.5 rounded-full" style="background:${accent}"></span>
          </div>
        </a>

        <div class="min-w-0">
          <p class="text-[0.6rem] uppercase tracking-[0.16em] text-terracotta-700">${escapeHtml(line.aroma)}</p>
          <h3 class="mt-0.5 font-display text-lg leading-tight text-jade-900">
            <a href="/producto/${collection}" class="transition-colors hover:text-terracotta-700">${escapeHtml(line.collectionName)}</a>
          </h3>
          <p class="mt-1 text-[0.72rem] text-ink/70">${escapeHtml(line.size.label)} · cera de soya</p>
          <p class="mt-0.5 text-[0.62rem] uppercase tracking-[0.1em] text-ink/70">${escapeHtml(line.sku)}</p>

          <div class="mt-3 flex flex-wrap items-center gap-3">
            <div class="flex items-center border border-cream-300 bg-cream-50">
              <button type="button" class="grid h-8 w-8 place-items-center text-jade-900 transition-colors hover:bg-cream-100" data-dec="${escapeHtml(line.sku)}" aria-label="Quitar una unidad de ${escapeHtml(line.collectionName)} ${escapeHtml(line.size.label)}">−</button>
              <input
                type="number"
                min="1"
                max="24"
                value="${line.qty}"
                data-qty-input="${escapeHtml(line.sku)}"
                aria-label="Cantidad de ${escapeHtml(line.collectionName)} ${escapeHtml(line.size.label)}"
                class="h-8 w-11 border-x border-cream-300 bg-transparent text-center text-[0.78rem] text-jade-900 focus:outline-none"
              />
              <button type="button" class="grid h-8 w-8 place-items-center text-jade-900 transition-colors hover:bg-cream-100" data-inc="${escapeHtml(line.sku)}" aria-label="Agregar una unidad de ${escapeHtml(line.collectionName)} ${escapeHtml(line.size.label)}">+</button>
            </div>
            <button type="button" class="text-[0.66rem] text-ink/70 underline underline-offset-2 transition-colors hover:text-terracotta-700" data-remove="${escapeHtml(line.sku)}">
              Quitar
            </button>
          </div>
        </div>

        <div class="col-span-2 flex items-baseline justify-between gap-3 sm:col-span-1 sm:block sm:text-right">
          <p class="font-display text-lg text-jade-900">${formatCOP(line.lineTotalCop)}</p>
          <p class="text-[0.64rem] text-ink/70">${formatCOP(line.unitPriceCop)} c/u</p>
        </div>
      </article>`;
  }

  function render(announce?: string) {
    const items = readCart();
    const lines = getLines(items);
    const coupon = readCoupon();
    // El importe se recalcula con el subtotal vigente; el servidor lo valida al pagar.
    const discountCop = coupon ? couponDiscountCop(coupon, getTotals(lines).subtotalCop) : 0;
    const totals = getTotals(lines, discountCop);

    if (loading) loading.hidden = true;

    const isEmpty = lines.length === 0;
    if (empty) empty.hidden = !isEmpty;
    if (content) content.hidden = isEmpty;

    if (countLabel) {
      countLabel.textContent = totals.itemCount === 0
        ? ''
        : ` (${totals.itemCount} ${totals.itemCount === 1 ? 'artículo' : 'artículos'})`;
    }

    if (linesHost) {
      linesHost.innerHTML = lines.map(lineTemplate).join('');
    }

    if (subtotalEl) subtotalEl.textContent = formatCOP(totals.subtotalCop);
    if (shippingEl) {
      shippingEl.textContent = totals.isFreeShipping ? 'Gratis' : formatCOP(totals.shippingCop);
      shippingEl.classList.toggle('text-jade-700', totals.isFreeShipping);
    }
    if (discountRow) discountRow.hidden = !coupon || totals.discountCop <= 0;
    if (discountEl) discountEl.textContent = totals.discountCop ? `−${formatCOP(totals.discountCop)}` : '—';
    if (discountCodeEl) discountCodeEl.textContent = coupon ? `(${coupon.code})` : '';
    if (couponApplied) couponApplied.hidden = !coupon;
    if (couponLabelEl) couponLabelEl.textContent = coupon?.label ?? '';
    if (couponInput) couponInput.disabled = !coupon;
    if (applyCouponButton) applyCouponButton.hidden = Boolean(coupon);
    if (totalEl) totalEl.textContent = formatCOP(totals.totalCop);

    const progress = Math.min(100, Math.round((totals.subtotalCop / shipping.freeFromCop) * 100));
    if (freeBar) freeBar.style.width = `${progress}%`;
    if (freeLabel) {
      freeLabel.textContent = totals.isFreeShipping
        ? 'Tu pedido tiene envío gratis'
        : `Te faltan ${formatCOP(totals.missingForFreeCop)} para el envío gratis`;
    }
    if (freeAmount) freeAmount.textContent = totals.isFreeShipping ? '100%' : `${progress}%`;

    if (announce && announcer) announcer.textContent = announce;
  }

  linesHost?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const inc = target.closest<HTMLElement>('[data-inc]');
    const dec = target.closest<HTMLElement>('[data-dec]');
    const remove = target.closest<HTMLElement>('[data-remove]');

    if (inc) {
      const sku = inc.dataset.inc ?? '';
      const current = readCart().find((item) => item.sku === sku)?.qty ?? 1;
      setQty(sku, current + 1);
      render('Cantidad actualizada.');
    } else if (dec) {
      const sku = dec.dataset.dec ?? '';
      const current = readCart().find((item) => item.sku === sku)?.qty ?? 1;
      if (current <= 1) {
        removeFromCart(sku);
        render('Producto retirado del carrito.');
      } else {
        setQty(sku, current - 1);
        render('Cantidad actualizada.');
      }
    } else if (remove) {
      removeFromCart(remove.dataset.remove ?? '');
      render('Producto retirado del carrito.');
    }
  });

  linesHost?.addEventListener('change', (event) => {
    const input = (event.target as HTMLElement).closest<HTMLInputElement>('[data-qty-input]');
    if (!input) return;
    const sku = input.dataset.qtyInput ?? '';
    const qty = Number(input.value);
    if (!Number.isFinite(qty) || qty < 1) {
      removeFromCart(sku);
      render('Producto retirado del carrito.');
      return;
    }
    setQty(sku, qty);
    render('Cantidad actualizada.');
  });

  document.querySelector('[data-clear-cart]')?.addEventListener('click', () => {
    if (!window.confirm('¿Vaciar el carrito? Se quitarán todos los productos.')) return;
    clearCart();
    render('Carrito vaciado.');
  });

  function setCouponMessage(message: string, tone: 'ok' | 'warn') {
    if (!couponMessage) return;
    couponMessage.textContent = message;
    couponMessage.hidden = false;
    couponMessage.className = `mt-2 text-[0.68rem] leading-relaxed ${
      tone === 'ok' ? 'text-jade-700' : 'text-terracotta-700'
    }`;
  }

  applyCouponButton?.addEventListener('click', async () => {
    const code = (couponInput?.value ?? '').trim();
    if (!code) {
      setCouponMessage('Escribe un código de descuento.', 'warn');
      return;
    }

    const original = applyCouponButton.textContent;
    applyCouponButton.disabled = true;
    applyCouponButton.textContent = 'Validando…';
    try {
      const response = await fetch('/api/coupons/validate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          code,
          subtotalCop: getTotals(getLines()).subtotalCop,
        }),
      });
      const data = (await response.json().catch(() => ({}))) as {
        ok?: boolean;
        error?: string;
        coupon?: StoredCoupon;
      };

      if (!response.ok || !data.ok || !data.coupon) {
        setCouponMessage(data.error || 'No pudimos aplicar el cupón.', 'warn');
        return;
      }

      saveCoupon(data.coupon);
      if (couponInput) couponInput.value = '';
      setCouponMessage('Cupón aplicado al pedido.', 'ok');
      render('Cupón aplicado.');
    } catch {
      setCouponMessage('No pudimos validar el cupón. Inténtalo de nuevo.', 'warn');
    } finally {
      applyCouponButton.disabled = false;
      applyCouponButton.textContent = original ?? 'Aplicar';
    }
  });

  couponInput?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
      applyCouponButton?.click();
    }
  });

  document.querySelector('[data-remove-coupon]')?.addEventListener('click', () => {
    clearCoupon();
    if (couponMessage) {
      couponMessage.hidden = true;
      couponMessage.textContent = '';
    }
    render('Cupón quitado.');
  });

  window.addEventListener(CART_EVENT, () => render());

  render();
</script>
