---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada · Iris Candles" description="La página que buscas no existe.">
  <section class="py-24">
    <div class="container-iris max-w-xl text-center">
      <p class="font-display text-6xl text-terracotta-600">404</p>
      <h1 class="mt-4 font-display text-3xl text-jade-900">Esta vela no está encendida</h1>
      <p class="mt-4 text-base text-ink/65">
        La página que buscas no existe o cambió de lugar. Vuelve al inicio o explora la tienda.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary">Ir al inicio</a>
        <a href="/tienda" class="btn-outline">Ver la tienda</a>
      </div>
    </div>
  </section>
</Base>
