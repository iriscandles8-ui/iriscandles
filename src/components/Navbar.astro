---
const links = [
  { href: '/tienda', label: 'Tienda' },
  { href: '/#colecciones', label: 'Colecciones' },
  { href: '/encuentra-tu-aroma', label: 'Tu aroma' },
  { href: '/eventos', label: 'Eventos' },
  { href: '/nosotros', label: 'Nosotros' },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href.startsWith('/#') ? false : pathname === href || pathname.startsWith(`${href}/`);
---

<div class="bg-jade-900 text-cream-50">
  <div
    class="container-iris flex flex-wrap items-center justify-center gap-x-6 gap-y-1 py-2 text-center text-[0.6rem] uppercase tracking-[0.18em] sm:justify-between sm:text-[0.66rem]"
  >
    <p>Hecho a mano en Colombia</p>
    <p class="text-cream-50/70">Envíos a todo el país · Nequi · Daviplata</p>
  </div>
</div>

<header class="sticky top-0 z-50 border-b border-cream-300/80 bg-cream-50/90 backdrop-blur-md">
  <nav class="container-iris flex items-center justify-between gap-4 py-3" aria-label="Principal">
    <a href="/" class="flex items-center gap-3" aria-label="Iris Candles, ir al inicio">
      <img
        src="/brand/logo-iris-candles.svg"
        alt=""
        width="44"
        height="44"
        class="h-11 w-11 object-contain"
      />
      <span class="hidden font-display text-[0.92rem] tracking-[0.18em] text-jade-900 sm:block">
        IRIS CANDLES
      </span>
    </a>

    <ul class="hidden items-center gap-7 lg:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'relative py-2 text-[0.78rem] uppercase tracking-[0.14em] transition-colors duration-200',
                isActive(link.href)
                  ? 'text-jade-900'
                  : 'text-jade-900/80 hover:text-jade-900',
              ]}
            >
              {link.label}
              {isActive(link.href) && (
                <span class="absolute inset-x-0 -bottom-0.5 h-px bg-terracotta-600" />
              )}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1">
      <a
        href="/carrito"
        data-cart-link
        class="relative inline-flex h-11 w-11 items-center justify-center rounded-full text-jade-900 transition-colors hover:bg-jade-50"
        aria-label="Carrito de compras"
      >
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M6 7h12l-1.2 12.1a1.5 1.5 0 0 1-1.5 1.4H8.7a1.5 1.5 0 0 1-1.5-1.4L6 7Z"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="round"
          />
          <path
            d="M9 7V5.6A3 3 0 0 1 12 3a3 3 0 0 1 3 2.6V7"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
          />
        </svg>
        <span
          data-cart-count
          hidden
          class="absolute right-1 top-1 flex h-4 min-w-4 items-center justify-center rounded-full bg-terracotta-600 px-1 text-[9px] font-medium leading-none text-cream-50"
        >
          0
        </span>
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full text-jade-900 transition-colors hover:bg-jade-50 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-cream-300 bg-cream-50 lg:hidden">
    <ul class="container-iris flex flex-col py-2">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block border-b border-cream-200/70 py-3.5 text-sm uppercase tracking-[0.14em] text-jade-900"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="/carrito"
          class="block py-3.5 text-sm uppercase tracking-[0.14em] text-jade-900"
        >
          Carrito
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  import { countItems, onCartChange } from '../lib/cart';

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      const open = !isHidden;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    });
  }

  /* Contador del carrito */
  const badge = document.querySelector<HTMLElement>('[data-cart-count]');
  const cartLink = document.querySelector<HTMLElement>('[data-cart-link]');

  function renderCartCount() {
    if (!badge) return;
    const count = countItems();
    badge.textContent = count > 99 ? '99+' : String(count);
    badge.hidden = count === 0;
    cartLink?.setAttribute(
      'aria-label',
      count === 0 ? 'Carrito de compras, vacío' : `Carrito de compras, ${count} artículo${count === 1 ? '' : 's'}`,
    );
  }

  renderCartCount();
  onCartChange(renderCartCount);
</script>
