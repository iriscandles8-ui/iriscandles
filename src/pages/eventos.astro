---
import Base from '../layouts/Base.astro';
---

<Base
  title="Eventos y pedidos por volumen · Iris Candles"
  description="Velas artesanales personalizadas para bodas, empresas, hoteles y celebraciones. Pedidos desde 15 unidades con cotización a medida."
>
  <section class="relative overflow-hidden border-b border-cream-300 bg-cream-100/40">
    <div class="container-iris py-14 lg:py-20">
      <p class="eyebrow text-terracotta-700">Eventos y empresas</p>
      <h1 class="mt-4 max-w-3xl font-display text-4xl leading-tight text-jade-900 sm:text-5xl">
        Velas que llevan tu nombre
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink/70">
        Diseñamos pedidos desde 15 unidades para bodas, cumpleaños, hoteles y regalos
        corporativos. Tú eliges el aroma, el tamaño y la etiqueta; nosotros nos encargamos del
        resto.
      </p>
    </div>
  </section>

  <section class="py-14 lg:py-20">
    <div class="container-iris grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <form id="event-form" class="grid gap-5" novalidate>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class="field-label" for="event-name">Nombre completo *</label>
              <input id="event-name" name="name" type="text" required autocomplete="name" class="field" />
            </div>
            <div>
              <label class="field-label" for="event-email">Correo *</label>
              <input id="event-email" name="email" type="email" required autocomplete="email" class="field" />
            </div>
            <div>
              <label class="field-label" for="event-phone">Teléfono / WhatsApp *</label>
              <input id="event-phone" name="phone" type="tel" required autocomplete="tel" class="field" />
            </div>
            <div>
              <label class="field-label" for="event-company">Empresa (opcional)</label>
              <input id="event-company" name="company" type="text" autocomplete="organization" class="field" />
            </div>
            <div>
              <label class="field-label" for="event-type">Tipo de evento *</label>
              <select id="event-type" name="event_type" required class="field">
                <option value="">Selecciona una opción</option>
                <option value="boda">Boda</option>
                <option value="cumpleanos">Cumpleaños</option>
                <option value="empresa">Empresa o regalo corporativo</option>
                <option value="hotel">Hotel o espacio comercial</option>
                <option value="otro">Otro</option>
              </select>
            </div>
            <div>
              <label class="field-label" for="event-quantity">Cantidad (mín. 15) *</label>
              <input
                id="event-quantity"
                name="quantity"
                type="number"
                min="15"
                step="1"
                required
                class="field"
                placeholder="15"
              />
            </div>
            <div class="sm:col-span-2">
              <label class="field-label" for="event-date">Fecha del evento</label>
              <input id="event-date" name="event_date" type="date" class="field" />
            </div>
            <div class="sm:col-span-2">
              <label class="field-label" for="event-message">Cuéntanos qué imaginas</label>
              <textarea
                id="event-message"
                name="message"
                rows="5"
                class="field resize-y"
                placeholder="Aroma, colores, empaque, fecha de entrega…"
              ></textarea>
            </div>
          </div>

          <div class="hidden" aria-hidden="true">
            <label>No llenar <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
          </div>

          <label class="flex items-start gap-3 text-xs leading-relaxed text-ink/60">
            <input type="checkbox" name="consent" required class="mt-0.5" />
            <span>
              Acepto la
              <a href="/legales#privacidad" class="border-b border-terracotta-600/40 text-jade-900">
                política de privacidad
              </a>
              y autorizo el contacto para cotizar mi pedido.
            </span>
          </label>

          <div class="flex flex-wrap items-center gap-4">
            <button type="submit" class="btn-primary">Enviar solicitud</button>
            <p data-status role="status" aria-live="polite" class="text-xs text-ink/60"></p>
          </div>
        </form>

        <div data-success hidden class="border border-cream-300 bg-cream-100/50 p-8">
          <p class="eyebrow text-terracotta-700">Solicitud recibida</p>
          <h2 class="mt-3 font-display text-3xl text-jade-900">
            Gracias, <span data-success-name>por escribirnos</span>.
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-ink/70">
            Revisaremos tu solicitud y te escribiremos en menos de 48 horas hábiles con una
            cotización y opciones de personalización.
          </p>
          <a href="/tienda" class="btn-outline mt-6">Mientras tanto, conoce la tienda</a>
        </div>
      </div>

      <aside class="lg:col-span-5">
        <div class="border border-cream-300 bg-cream-100/40 p-6 sm:p-8">
          <h2 class="font-display text-2xl text-jade-900">Cómo funciona</h2>
          <ol class="mt-6 space-y-5">
            {
              [
                ['01', 'Nos cuentas', 'Fecha, cantidad, ocasión y el aroma que tienes en mente.'],
                ['02', 'Cotizamos', 'Te enviamos precio por unidad, tiempos y opciones de empaque.'],
                ['03', 'Producimos', 'Vertemos tu pedido en lotes y coordinamos la entrega.'],
              ].map(([number, title, text]) => (
                <li class="flex gap-4">
                  <span class="font-display text-sm tracking-[0.16em] text-terracotta-700">{number}</span>
                  <div>
                    <p class="font-display text-base text-jade-900">{title}</p>
                    <p class="mt-1 text-sm leading-relaxed text-ink/60">{text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="mt-6 border border-cream-300 p-6 sm:p-8">
          <h2 class="font-display text-xl text-jade-900">Qué podemos personalizar</h2>
          <ul class="mt-4 space-y-2 text-sm text-ink/70">
            <li>· Etiqueta con tu nombre, logo o fecha</li>
            <li>· Aroma entre las cuatro colecciones</li>
            <li>· Tamaño de 120 g o 240 g</li>
            <li>· Empaque individual o caja regalo</li>
          </ul>
          <p class="mt-5 text-[0.68rem] uppercase tracking-[0.14em] text-jade-900/45">
            Mínimo 15 unidades · Entrega desde 10 días hábiles
          </p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('event-form') as HTMLFormElement | null;
  const status = document.querySelector<HTMLElement>('[data-status]');
  const success = document.querySelector<HTMLElement>('[data-success]');
  const MIN_FILL_MS = 1500;
  const mountedAt = Date.now();
  const successName = document.querySelector<HTMLElement>('[data-success-name]');
  const dateInput = document.getElementById('event-date') as HTMLInputElement | null;

  if (dateInput) {
    dateInput.min = new Date().toISOString().slice(0, 10);
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const honeypot = String(data.get('website') ?? '');
    if (honeypot.trim() !== '') return;
    if (Date.now() - mountedAt < MIN_FILL_MS) return;

    const name = String(data.get('name') ?? '').trim();
    const payload = {
      name,
      email: String(data.get('email') ?? '').trim().toLowerCase(),
      phone: String(data.get('phone') ?? '').trim(),
      company: String(data.get('company') ?? '').trim() || null,
      event_type: String(data.get('event_type') ?? ''),
      quantity: Number(data.get('quantity') ?? 0),
      event_date: String(data.get('event_date') ?? '') || null,
      message: String(data.get('message') ?? '').trim() || null,
    };

    if (payload.quantity < 15) {
      if (status) status.textContent = 'El pedido mínimo es de 15 unidades.';
      return;
    }

    if (status) status.textContent = 'Enviando…';

    try {
      if (supabase) {
        const { error } = await supabase.from('event_requests').insert(payload);
        if (error) throw error;
      } else {
        await new Promise((resolve) => setTimeout(resolve, 700));
      }

      form.classList.add('hidden');
      success?.classList.remove('hidden');
      if (successName) successName.textContent = name.split(' ')[0] || 'gracias';
    } catch {
      if (status) status.textContent = 'No pudimos enviar la solicitud. Escríbenos a hola@iriscandles.com.';
    }
  });
</script>
