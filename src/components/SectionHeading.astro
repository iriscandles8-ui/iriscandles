---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'left' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow text-terracotta-700">{eyebrow}</p>}
  <h2 class="mt-3 font-display text-3xl leading-[1.15] text-jade-900 sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-base leading-relaxed text-ink/70">{description}</p>}
</div>
