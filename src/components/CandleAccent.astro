---
interface Props {
  src: string;
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
  delay?: number;
  glow?: boolean;
}

const {
  src,
  alt = '',
  class: className = '',
  width,
  height,
  delay = 0,
  glow = false,
} = Astro.props;
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading="lazy"
  decoding="async"
  draggable="false"
  aria-hidden={alt ? undefined : 'true'}
  class:list={['candle-accent', glow && 'candle-accent-glow', className]}
  style={`--candle-delay:${delay}s`}
/>
