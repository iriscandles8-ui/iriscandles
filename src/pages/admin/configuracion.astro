            </div>
          </div>

          <div>
            <label class="admin-label" for="policy-returns-text">Texto de devoluciones y cambios</label>
            <textarea id="policy-returns-text" rows="4" class="admin-textarea">Aceptamos cambios y devoluciones dentro de los 5 días siguientes a la entrega, siempre que la vela no haya sido encendida y conserve su empaque original. Los daños por transporte se reemplazan sin costo.</textarea>
          </div>

          <div>
            <label class="admin-label" for="policy-privacy-text">Tratamiento de datos personales</label>
            <textarea id="policy-privacy-text" rows="4" class="admin-textarea">Los datos se usan únicamente para procesar pedidos, enviar novedades y cumplir obligaciones legales. Puedes solicitar su actualización o eliminación escribiendo a hola@iriscandles.com. Cumplimos la Ley 1581 de 2012.</textarea>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-2 border-t border-cream-300 pt-4">
            <p class="text-[0.66rem] text-ink/45">Los textos completos viven en /legales.</p>
            <button type="button" class="admin-btn admin-btn-primary" data-save="Políticas guardadas">
              Guardar políticas
            </button>
          </div>
        </div>

        <aside class="space-y-4">
          <div class="border border-cream-300 bg-cream-50 p-4">
            <p class="text-[0.58rem] uppercase tracking-[0.16em] text-jade-900/45">Documentos públicos</p>
            <ul class="mt-3 space-y-2">
              {[
                ['Términos y condiciones', '/legales#terminos'],
                ['Política de privacidad', '/legales#privacidad'],
                ['Envíos y devoluciones', '/legales#envios'],
                ['Preguntas frecuentes', '/legales#faq'],
              ].map(([label, href]) => (
                <li>
                  <a href={href} target="_blank" rel="noopener" class="flex items-center justify-between gap-2 border border-cream-300 bg-cream-50 px-3 py-2 text-[0.74rem] text-ink/65 transition-colors hover:border-jade-900/30 hover:text-jade-900">
                    {label}
                    <AdminIcon name="external" size={13} class="text-ink/30" />
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="border border-cream-300 bg-cream-50 p-4">
            <p class="text-[0.58rem] uppercase tracking-[0.16em] text-jade-900/45">Cumplimiento</p>
            <p class="mt-2 text-[0.72rem] leading-relaxed text-ink/55">
              Al operar en Colombia necesitas RUT, régimen tributario definido y política de
              tratamiento de datos. La tienda muestra precios con IVA incluido.
            </p>
          </div>
        </aside>
      </div>
    </div>

    <!-- ------------------------------ Conexión ------------------------------ -->
    <div data-config-panel="conexion" hidden>
      <div class="grid gap-6 p-5 lg:grid-cols-[1.4fr_1fr] lg:p-6">
        <div class="space-y-3">
          <div>
            <h2 class="admin-card-title">Servicios conectados</h2>
            <p class="mt-0.5 text-[0.7rem] text-ink/45">
              Estas son las integraciones que necesita la tienda. Las claves se guardan como variables
              de entorno, nunca en el código.
            </p>
          </div>

          {
            connectionItems.map((item) => (
              <div class="flex flex-wrap items-start gap-3 border border-cream-300 bg-cream-50 p-3.5">
                <span
                  class:list={[
                    'grid h-9 w-9 shrink-0 place-items-center rounded-xs',
                    item.configured ? 'bg-jade-50 text-jade-800' : 'bg-cream-200 text-ink/45',
                  ]}
                >
                  <AdminIcon name={item.id === 'supabase' ? 'box' : item.id === 'wompi' ? 'card' : item.id === 'resend' ? 'mail' : 'external'} size={16} />
                </span>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <p class="text-[0.82rem] font-medium text-jade-900">{item.name}</p>
                    <span class="admin-badge" data-tone={item.configured ? 'jade' : 'slate'}>
                      {item.configured ? 'Conectado' : 'Sin conectar'}
                    </span>
                  </div>
                  <p class="mt-0.5 text-[0.7rem] text-ink/50">{item.role}</p>
                  {
                    item.env.length > 0 && (
                      <p class="mt-1.5 flex flex-wrap gap-1">
                        {item.env.map((variable) => (
                          <code class="rounded-xs bg-cream-200/70 px-1.5 py-0.5 text-[0.6rem] text-jade-900">{variable}</code>
                        ))}
                      </p>
                    )
                  }
                </div>
                <a href={item.href} target="_blank" rel="noopener" class="admin-btn admin-btn-outline admin-btn-sm">
                  Abrir
                  <AdminIcon name="external" size={12} />
                </a>
              </div>
            ))
          }
        </div>

        <aside class="space-y-4">
          <div class:list={['border p-4', isDemoMode ? 'border-amber-200 bg-amber-50' : 'border-jade-900/20 bg-jade-50/60']}>
            <p class:list={['text-[0.58rem] uppercase tracking-[0.16em]', isDemoMode ? 'text-amber-800' : 'text-jade-900/45']}>
              Estado actual
            </p>
            <p class="mt-2 text-[0.8rem] font-medium text-jade-900">
              {isDemoMode ? 'Panel en modo demostración' : 'Supabase conectado'}
            </p>
            <p class="mt-1 text-[0.7rem] leading-relaxed text-ink/55">
              {
                isDemoMode
                  ? 'No hay variables de Supabase. Los datos viven en memoria y se pierden al recargar.'
                  : 'La autenticación y las consultas usan el proyecto de Supabase configurado.'
              }
            </p>
          </div>

          <div class="border border-cream-300 bg-cream-50 p-4">
            <p class="text-[0.58rem] uppercase tracking-[0.16em] text-jade-900/45">Pasos para conectar Supabase</p>
            <ol class="mt-2.5 list-decimal space-y-1.5 pl-4 text-[0.7rem] leading-relaxed text-ink/55">
              <li>Crea un proyecto gratuito en supabase.com.</li>
              <li>Ejecuta <code class="text-jade-900">db/schema.sql</code> en el SQL Editor.</li>
              <li>Ejecuta <code class="text-jade-900">db/admin.sql</code>.</li>
              <li>Crea tu usuaria en Authentication → Users.</li>
              <li>Registra su UUID en <code class="text-jade-900">admin_users</code> con rol <em>owner</em>.</li>
              <li>Copia la URL y la clave anónima a <code class="text-jade-900">.env</code>.</li>
            </ol>
          </div>

          <div class="border border-rose-200 bg-rose-50 p-4">
            <div class="flex items-start gap-2">
              <AdminIcon name="alert" size={15} class="mt-0.5 shrink-0 text-rose-700" />
              <div>
                <p class="text-[0.72rem] font-medium text-rose-900">Nunca expongas la service role key</p>
                <p class="mt-1 text-[0.68rem] leading-relaxed text-rose-800">
                  La clave pública (anon) es la única que puede llegar al navegador. La seguridad del
                  panel depende de las políticas RLS, no de ocultar la interfaz.
                </p>
              </div>
            </div>
          </div>

          <div class="border border-cream-300 bg-cream-50 p-4">
            <p class="text-[0.58rem] uppercase tracking-[0.16em] text-jade-900/45">Prueba de conexión</p>
            <p class="mt-1.5 text-[0.7rem] leading-relaxed text-ink/50">
              Guarda las variables, reinicia el servidor de desarrollo y vuelve a entrar al panel.
            </p>
            <button type="button" class="admin-btn admin-btn-outline admin-btn-sm mt-2.5 w-full" data-test-connection>
              <AdminIcon name="refresh" size={13} />
              Probar conexión
            </button>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <p class="mt-5 flex items-center gap-1.5 text-[0.66rem] text-ink/35">
    <AdminIcon name="lock" size={12} />
    Los cambios sensibles quedan registrados en <code class="text-jade-900/60">audit_log</code> con usuario y fecha.
  </p>
</AdminLayout>

<script type="application/json" id="settings-zones" set:html={JSON.stringify(zones)}></script>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-config-tab]');
  const panels = document.querySelectorAll<HTMLElement>('[data-config-panel]');

  function activateTab(id: string) {
    const exists = Array.from(panels).some((panel) => panel.dataset.configPanel === id);
    const target = exists ? id : 'tienda';

    tabs.forEach((tab) => {
      const active = tab.dataset.configTab === target;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-selected', String(active));
    });

    panels.forEach((panel) => {
      panel.hidden = panel.dataset.configPanel !== target;
    });

    if (window.location.hash !== `#${target}`) {
      history.replaceState(null, '', `#${target}`);
    }
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => activateTab(tab.dataset.configTab ?? 'tienda'));
  });

  document.querySelectorAll<HTMLElement>('[data-config-goto]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      activateTab(link.dataset.configGoto ?? 'conexion');
      document.querySelector('.admin-card')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  const initial = window.location.hash.replace('#', '');
  if (initial) activateTab(initial);

  window.addEventListener('hashchange', () => {
    activateTab(window.location.hash.replace('#', '') || 'tienda');
  });

  /* ---------------------------- Guardar (demo) ---------------------------- */

  document.querySelectorAll<HTMLElement>('[data-save]').forEach((button) => {
    button.addEventListener('click', () => {
      (window as any).adminToast(`${button.dataset.save ?? 'Cambios guardados'} (demo).`);
    });
  });

  document.querySelector('[data-upload-logo]')?.addEventListener('click', () => {
    (window as any).adminToast('Sube un PNG de 800 × 800 px a Storage → brand (demo).');
  });

  document.querySelector('[data-export-settings]')?.addEventListener('click', async () => {
    const { downloadCsv } = await import('../../lib/admin');
    const zones = JSON.parse(document.getElementById('settings-zones')?.textContent ?? '[]') as {
      name: string;
      base: number;
      perKg: number;
      eta: string;
      freeFrom: number;
    }[];

    downloadCsv('iris-configuracion-envios.csv', [
      ['Zona', 'Tarifa base COP', 'Por kg COP', 'Entrega', 'Gratis desde COP'],
      ...zones.map((zone) => [zone.name, zone.base, zone.perKg, zone.eta, zone.freeFrom]),
    ]);
    (window as any).adminToast('Configuración de envíos exportada.');
  });

  /* ------------------------------ Zonas ------------------------------ */

  const zonesBody = document.getElementById('zones-body');

  document.querySelector('[data-add-zone]')?.addEventListener('click', () => {
    if (!zonesBody) return;
    const id = `zone-${Date.now()}`;
    const row = document.createElement('tr');
    row.dataset.zoneRow = id;
    row.innerHTML = `
      <td><input class="admin-input py-1.5 text-[0.78rem]" value="Nueva zona" aria-label="Nombre de la zona" /></td>
      <td class="num"><input type="number" min="0" step="1000" class="admin-input py-1.5 text-right text-[0.78rem]" value="12000" aria-label="Tarifa base" /></td>
      <td class="num"><input type="number" min="0" step="500" class="admin-input py-1.5 text-right text-[0.78rem]" value="0" aria-label="Costo por kilo" /></td>
      <td><input class="admin-input py-1.5 text-[0.78rem]" value="2–4 días" aria-label="Tiempo de entrega" /></td>
      <td class="num"><input type="number" min="0" step="1000" class="admin-input py-1.5 text-right text-[0.78rem]" value="180000" aria-label="Envío gratis desde" /></td>
      <td class="text-right">
        <button type="button" class="admin-icon-btn hover:bg-rose-50 hover:text-rose-700" data-delete-zone="${id}" aria-label="Eliminar zona">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        </button>
      </td>`;
    zonesBody.appendChild(row);
    (window as any).adminToast('Zona agregada. Recuerda guardar las tarifas (demo).');
  });

  zonesBody?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const button = target.closest<HTMLButtonElement>('[data-delete-zone]');
    if (!button) return;
    const row = button.closest('tr');
    row?.remove();
    (window as any).adminToast('Zona eliminada (demo).', 'warn');
  });

  /* ------------------------------ Permisos ------------------------------ */

  document.querySelectorAll<HTMLButtonElement>('[data-staff-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const on = button.classList.toggle('is-on');
      button.setAttribute('aria-checked', String(on));
      const label = button.parentElement?.querySelector<HTMLElement>('[data-staff-status]');
      if (label) label.textContent = on ? 'Activo' : 'Suspendido';
      (window as any).adminToast(
        on ? 'Acceso al panel reactivado (demo).' : 'Acceso al panel suspendido (demo).',
        on ? 'ok' : 'warn',
      );
    });
  });

  document.querySelectorAll<HTMLSelectElement>('[data-staff-role]').forEach((select) => {
    select.addEventListener('change', () => {
      (window as any).adminToast(`Rol actualizado a “${select.selectedOptions[0]?.textContent?.trim()}” (demo).`);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-staff-remove]').forEach((button) => {
    button.addEventListener('click', () => {
      if (button.disabled) return;
      const row = button.closest('tr');
      if (!window.confirm('¿Quitar el acceso de esta persona al panel?')) return;
      row?.remove();
      (window as any).adminToast('Acceso retirado (demo).', 'warn');
    });
  });

  document.querySelector('[data-invite]')?.addEventListener('click', () => {
    const email = window.prompt('Correo de la persona que quieres invitar:');
    if (!email) return;
    (window as any).adminToast(`Invitación enviada a ${email.trim()} (demo).`);
  });

  document.querySelectorAll<HTMLInputElement>('[data-payment-method]').forEach((input) => {
    input.addEventListener('change', () => {
      (window as any).adminToast(
        `${input.dataset.paymentMethod?.toUpperCase()} ${input.checked ? 'habilitado' : 'deshabilitado'} (demo).`,
        input.checked ? 'ok' : 'warn',
      );
    });
  });

  document.querySelector('[data-test-connection]')?.addEventListener('click', () => {
    (window as any).adminToast('Sin variables de entorno: no hay conexión que probar (demo).', 'warn');
  });
</script>
